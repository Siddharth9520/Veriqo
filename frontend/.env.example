# Veriqo Environment Configuration
# Base URL for the Veriqo Backend API
# Leave blank to use local Next.js full-stack route handlers (/api/v1)
# Or set to external service: e.g. http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=

# Veriqo Cluster Environment (staging | prod | dev)
NEXT_PUBLIC_VERIQO_CLUSTER_ENV=staging

# Optional Chrome DevTools Protocol CDP Endpoint for Live Browser Stream
NEXT_PUBLIC_CDP_WS_URL=ws://127.0.0.1:9222
